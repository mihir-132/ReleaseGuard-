# payment-service environment variables
# Copy to .env and fill in real values before deploying.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=
# NEW in v1.2.0: replaces DATABASE_MAX_CONNECTIONS
DATABASE_POOL_SIZE=10

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
# NEW in v1.2.0: required for refresh-token rotation
JWT_REFRESH_SECRET=

# ── Feature flags ─────────────────────────────────────────────────────────────
# NEW in v1.2.0: enable the v2 checkout endpoint
FEATURE_FLAG_CHECKOUT_V2=false
# Deprecated in v1.2.0 (kept for backward compat, will be removed in v1.3.0)
# FEATURE_FLAG_NEW_CHECKOUT=false

# ── Application ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
