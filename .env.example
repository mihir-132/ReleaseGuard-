# ──────────────────────────────────────────────────────────────────────────────
# watsonx.ai — AI-generated release notes (Step 08)
# ──────────────────────────────────────────────────────────────────────────────

# IBM Cloud API key used to obtain an IAM bearer token for watsonx.ai requests.
# Required for AI release note generation; omitting it activates the fallback.
WATSONX_API_KEY=

# watsonx.ai project ID that owns the deployment/model to call.
# Required for AI release note generation; omitting it activates the fallback.
WATSONX_PROJECT_ID=

# Base URL of the watsonx.ai service instance.
# Default shown below; change to your regional endpoint if needed (e.g. eu-de).
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model ID to use for text generation.
# Default shown below; can be overridden with any compatible watsonx.ai model.
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ──────────────────────────────────────────────────────────────────────────────
# Express server
# ──────────────────────────────────────────────────────────────────────────────

# HTTP port the server listens on (optional, defaults to 3000).
PORT=3000
